# Application
APP_NAME="Family Safety Net API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=false
API_V1_PREFIX="/api/v1"

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/family_safety_net"

# Security (Generate random 32+ char secret for production)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars"

# SMS Provider (Twilio)
TWILIO_ACCOUNT_SID="AC_mock_twilio_account_sid"
TWILIO_AUTH_TOKEN="mock_twilio_auth_token"
TWILIO_FROM_NUMBER="+15005550006"

# Email Provider (Brevo / Standard SMTP)
SMTP_ENABLED=true
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USERNAME="your_brevo_account@smtp-brevo.com"
SMTP_PASSWORD="your_brevo_smtp_key"
SMTP_FROM_EMAIL="your_verified_sender@example.com"
SMTP_USE_TLS=true

# Email Provider Alternative (Resend API)
RESEND_API_KEY="re_mock_resend_api_key"
RESEND_FROM_EMAIL="onboarding@resend.dev"
