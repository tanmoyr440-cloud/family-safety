      "purpose": "any"
    },
    {
      "src": "/icons/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Emergency Alerts",
      "short_name": "Alerts",
      "description": "View notification logs and preview emergency alerts",
      "url": "/notifications",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Trusted Contacts",
      "short_name": "Contacts",
      "description": "Manage emergency contacts and priority escalation",
      "url": "/contacts",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    },
    {
      "name": "Loan Obligations",
      "short_name": "Loans",
      "description": "Track monthly car-loan EMI and payments",
      "url": "/loans",
      "icons": [{ "src": "/icons/icon-192.svg", "sizes": "192x192" }]
    }
  ],
  "categories": ["finance", "utilities", "productivity"]
}
